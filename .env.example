# Copy to .env and fill in the key(s) for the provider(s) you want to use.
# You only need the key for the provider you pass to `npm run render -- --provider <name>` (or `agent`).

# --- Anthropic (Claude) ---  provider: anthropic
ANTHROPIC_API_KEY=
# Optional overrides:
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- DeepSeek ---  provider: deepseek  (OpenAI-compatible)
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Google AI Studio (Gemini) ---  provider: gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-pro
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# --- Google Vertex AI (Gemini) ---  provider: vertex
# Pick ONE of the two modes below.
# (a) Express mode — a plain Vertex API key string:
GOOGLE_VERTEX_API_KEY=
# (b) Service account — point at the downloaded JSON file + set project/region:
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-pro

# --- OpenAI (official) ---  provider: openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Any OpenAI-compatible endpoint (OpenRouter, Ollama, LM Studio, vLLM, …) ---  provider: compatible
# Point it at whatever endpoint you like; defaults to OpenRouter.
COMPATIBLE_API_KEY=
# COMPATIBLE_MODEL=openrouter/auto
# COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
