# Path B generation image (isolation control #2). UNLIKE Dockerfile.worker (render-only, --omit=dev),
# generation needs the FULL toolchain: the Vite dev server + Playwright/Chromium the layout inspector
# uses, plus the agent loop + LLM SDKs. It is launched per-job by server/render/generate-dispatch.mjs
# on an INTERNAL docker network (no direct internet) with ISOLATE_INSPECT=1 and HTTPS_PROXY pointed at
# the egress-guard, under gVisor, read-only + tmpfs, cap-drop, ephemeral.
#   docker build -f Dockerfile.gen -t mcg-gen:latest .
FROM node:22-slim

# Headless-Chromium runtime libraries (same set the render worker needs).
RUN apt-get update && apt-get install -y --no-install-recommends \
      libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 libpango-1.0-0 \
      libcairo2 libatspi2.0-0 fonts-liberation fonts-dejavu-core ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json* ./
# FULL install — Vite/Playwright/tsc are devDependencies and generation needs them.
RUN npm ci 2>/dev/null || npm install
# Playwright's Chromium into a SHARED, world-readable path (installed as root here, but the container
# runs as `node` — the default per-user cache would be unreachable). PLAYWRIGHT_BROWSERS_PATH persists
# to runtime so the node user's Playwright finds it.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install chromium && chmod -R a+rX /ms-playwright

# The source generation needs: components/tokens/posts (src), the agent + inspector (tools),
# briefing context, schemas, and the build config.
COPY server ./server
COPY tools ./tools
COPY context ./context
COPY schemas ./schemas
COPY src ./src
COPY brand.config.json remotion.config.ts tailwind.config.ts postcss.config.js tsconfig.json vite.config.ts index.html ./

# Non-root. The generated-spec dir, caches, and /tmp are tmpfs-mounted writable at run time
# (rootfs is read-only) — see generate-dispatch.mjs.
USER node
CMD ["node", "server/render/gen-entry.mjs"]
